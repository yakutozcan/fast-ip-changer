# Wails build output
build/bin
frontend/package.json.md5

# Vite output. The directory itself must stay tracked: main.go embeds it with
# //go:embed, which fails when the pattern matches no files, so a fresh clone
# needs the .gitkeep placeholder for `go build`/`go test` to work.
frontend/dist/*
!frontend/dist/.gitkeep

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# Go build & test artifacts
/fast-ip-changer
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
coverage.out
coverage.txt
*.prof

