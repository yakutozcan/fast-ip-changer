{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "description": "React frontend for Fast IP Changer, a Wails desktop utility for switching between static IP and DHCP.",
  "license": "MIT",
  "author": "Yakut Özcan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakutozcan/fast-ip-changer.git",
    "directory": "frontend"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
