{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "oxc",
    "typescript",
    "unicorn",
    "react",
    "jsx-a11y",
    "promise",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "wailsjs"
  ],
  "rules": {
    "import/no-unassigned-import": "off",
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      {
        "roles": [
          "log"
        ]
      }
    ],
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/react-in-jsx-scope": "off"
  }
}
